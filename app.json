{
  "expo": {
    "name": "InkaPark",
    "slug": "inkapark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.xrodrigo.inkapark",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#160C05",
        "foregroundImage": "./assets/logo.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "InkaPark necesita acceder a la cámara para escanear y validar los boletos de ingreso.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "b64cddcd-e0c5-4044-af6f-4ef8611583fa"
      }
    }
  }
}
